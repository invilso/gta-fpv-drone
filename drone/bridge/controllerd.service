[Unit]
Description=Generic joystick/gamepad bridge for GTA SA (moonloader/tx12.lua + moonloader/drone.lua)

[Service]
# Rewritten by installer/install.sh to the real uv binary + install path --
# this default is only a placeholder for manual setup.
ExecStart=uv run /path/to/moonloader/drone/bridge/controllerd.py
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
